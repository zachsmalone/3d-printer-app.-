# Copy to .env (never commit .env). Used by reports/deploy/docker-compose.yml.

# Public hostname Caddy serves and gets a Let's Encrypt certificate for (placeholder!)
ZEIM_DOMAIN=zeim.example.org
# Email for Let's Encrypt expiry notices
ACME_EMAIL=nightmareopsstudio@gmail.com

# Moderation queue token (header X-Admin-Token). Generate: openssl rand -hex 32
PHOTO3D_ADMIN_TOKEN=

# Fernet key for encrypted OAuth tokens (app/services/accounts.py). If empty the app creates data/secret.key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHOTO3D_SECRET_KEY=

# Optional OAuth connect scaffolding, pattern PHOTO3D_<PROVIDER>_CLIENT_ID / _CLIENT_SECRET
# PHOTO3D_TIKTOK_CLIENT_ID=
# PHOTO3D_TIKTOK_CLIENT_SECRET=

# Host directories holding persistent state (bind-mounted to /data and /outputs). Must be owned by 10001:10001.
ZEIM_HOST_DIR=/srv/zeim

# --- App (ZEIM) settings; see README "Configuration flags" ---
# Network binding: default 127.0.0.1 (this computer only). The Docker image sets HOST=0.0.0.0 on purpose (the proxy
# container reaches it on the private compose network; the port is not published). There is NO real authentication yet.
# HOST=127.0.0.1
# PORT=8765
# shared (default for servers) | local (your own machine only)
PHOTO3D_MODE=shared
# URL used in join QR codes and slicer links. If set, nobody can change it from the UI.
# PHOTO3D_PUBLIC_BASE_URL=https://zeim.example.org

# Shared mode refuses printer addresses that point at the server itself or private networks (SSRF guard).
# Set 1 only if you self-host on the printer's LAN and want 10.x/172.16.x/192.168.x printer addresses.
# Loopback and link-local (cloud metadata) stay blocked. Local mode never restricts printer addresses.
# PHOTO3D_LAN_PRINTERS=0

# --- Safety re-check 1 additions ---
# Secure flag on cookies: auto (default: when the request came over https) | true | false
#PHOTO3D_COOKIE_SECURE=auto
# Expose /docs, /redoc and /openapi.json (off by default)
#PHOTO3D_API_DOCS=0
# Wrong admin tokens per 10 minutes per address before 429 (even for the right token)
#PHOTO3D_ADMIN_FAIL_LIMIT=10
# After a "can't create an account" age result, this network address also can't retry for N minutes (0 = off). A shared household or library address blocks others for that long.
#PHOTO3D_AGE_IP_LOCK_MINUTES=30
# NOTE: PHOTO3D_MODE=local only trusts requests from this computer (loopback address + loopback Host header, no proxy headers).
# Anything arriving through a tunnel/proxy or from the LAN is treated like shared mode. Run any tunnel with PHOTO3D_MODE=shared anyway.

# --- Accounts (passkey / email-code login) ---
# ZEIM_ENV: dev | production. dev (or a loopback HOST) fills safe local defaults below.
# production FAILS CLOSED: with ZEIM_ENV=production (or PHOTO3D_PUBLIC_LAUNCH=1) the app refuses to
# start unless the three values below are set and strong — it never silently falls back to the
# legacy cookie login.
# ZEIM_ENV=production
# Your site's domain (WebAuthn relying-party id). No scheme, no port: zeim.example.org
# ZEIM_RP_ID=zeim.example.org
# Comma-separated https origins that may call the auth API (scheme + host + port).
# ZEIM_ORIGINS=https://zeim.example.org
# Secret pepper for auth hashing (32+ chars). Generate: openssl rand -hex 32
# ZEIM_AUTH_PEPPER=
# Where the auth SQLite database lives (inside the bind-mounted data dir)
# ZEIM_AUTH_DB=/srv/zeim/data/auth.sqlite3
# Trust X-Forwarded-* headers from a reverse proxy on the same host (Caddy in reports/deploy)
# ZEIM_TRUST_PROXY=1

# --- Paid plans and the public coming-soon page (both default off) ---
# ZEIM_PLANS_ENABLED=0 hides checkout. Account → Plans can still list Semi Pro / Pro as "Coming later".
# 1 does not charge and does not require Stripe keys. Do not put live Stripe keys in this file.
# ZEIM_PLANS_ENABLED=0
# ZEIM_COMING_SOON=1 shows static/coming-soon.html for every path except /healthz.
# Leave it unset or 0 so testers reach the full app at the public site. Caddy uses the same flag
# (reports/deploy/caddy-run.sh). On GCP zeim-prod, deploy reports/deploy/Caddyfile with this off.
# ZEIM_COMING_SOON=0
# ZEIM_2D3D_ENABLED=0 hides the 2D→3D tab and does not start TripoSR jobs. 1 turns that tab back on.
# ZEIM_2D3D_ENABLED=0

# --- Email sign-in codes (optional; passkeys work without SMTP) ---
# Without these, email endpoints honestly return 503 "use your passkey".
# ZEIM_SMTP_HOST=smtp.example.org
# ZEIM_SMTP_PORT=587
# ZEIM_SMTP_FROM=ZEIM <nightmareopsstudio@gmail.com>
# ZEIM_SMTP_USER=
# ZEIM_SMTP_PASSWORD=
# ZEIM_SMTP_STARTTLS=1
