# PRODUCTION environment. Real values live ONLY here (never committed with real secrets).
# Launch gate: the app refuses to start with ZEIM_ENV=production unless auth is fully configured
# (ZEIM_RP_ID / ZEIM_ORIGINS / ZEIM_AUTH_PEPPER) — no silent cookie-login fallback.

ZEIM_DOMAIN=zeim.example.org
ACME_EMAIL=ops@example.org
PHOTO3D_ADMIN_TOKEN=            # openssl rand -hex 32
PHOTO3D_SECRET_KEY=             # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZEIM_HOST_DIR=/srv/zeim

PHOTO3D_MODE=shared
PHOTO3D_PUBLIC_BASE_URL=https://zeim.example.org

ZEIM_STORAGE=db
ZEIM_ENV=production
ZEIM_RP_ID=zeim.example.org
ZEIM_ORIGINS=https://zeim.example.org
ZEIM_AUTH_PEPPER=               # openssl rand -hex 32
ZEIM_TRUST_PROXY=1
PHOTO3D_COOKIE_SECURE=auto
PHOTO3D_BLOCK_PRIVATE_PRINTERS=1
PHOTO3D_API_DOCS=0

# Upload gate (per account per hour; 0 = off)
PHOTO3D_UPLOADS_PER_HOUR=10
# Optional local malware scanning via clamd (needs a local clamd; unreachable = allow + log)
# PHOTO3D_CLAMAV=1
# PHOTO3D_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# Slicing resource caps
PHOTO3D_SLICE_TIMEOUT=300
PHOTO3D_SLICE_MEM_MB=2048

# Object storage (optional; unset = local disk)
# PHOTO3D_S3_ENDPOINT=
# PHOTO3D_S3_BUCKET=
# PHOTO3D_S3_KEY=
# PHOTO3D_S3_SECRET=

# SMTP for email sign-in codes (optional; passkeys work without it)
# ZEIM_SMTP_HOST=
# ZEIM_SMTP_PORT=587
# ZEIM_SMTP_FROM=
# ZEIM_SMTP_USER=
# ZEIM_SMTP_PASSWORD=

# Backups: cron on the host runs scripts/backup.py daily (docs/ops/backup-restore.md),
# then an encrypted copy goes off-site (age + restic/rclone). Retention is automatic.

# Printer control: production is file-handoff only (download .gcode) unless explicitly re-enabled
# ZEIM_PRINTER_DIRECT=1

# Paid plans stay closed. Do not set Stripe secret keys for this release.
ZEIM_PLANS_ENABLED=0
# Full app on the public site (testers use https://zeimapp.com). 1 puts the coming-soon page back.
ZEIM_COMING_SOON=0
# Photo-to-3D / TripoSR stays off. Lithophanes, slicers, CAD and Showcase stay on.
ZEIM_2D3D_ENABLED=0

# Backup encryption: the age PUBLIC key (age1...). The private key file lives ONLY off-site.
# ZEIM_BACKUP_AGE_RECIPIENT=age1...
