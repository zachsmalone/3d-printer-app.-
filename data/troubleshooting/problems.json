    {"id":"stringing","name":"Stringing","symptoms":["Thin plastic hairs between parts","Webbing across gaps"],"likely_causes":[{"cause":"Needs diagnosis from symptoms and printer condition","likelihood":"medium"}],"fixes":[{"slicer_key":"nozzle_temperature","direction":"decrease","amount":"5-10 C","note":"Reduce gradually"},{"slicer_key":"retraction_distance","direction":"increase","amount":"0.1-0.5 mm","note":"Calibrate for extruder type"},{"slicer_key":"retraction_speed","direction":"increase","amount":"5-15 mm/s","note":"Increase gradually"},{"slicer_key":"travel_avoid_crossing_perimeters","direction":"enable","amount":null,"note":"Reduce open travel"}],"printer_notes":{"creality_k1":"Direct drive needs low retraction.","bambu":"Use Bambu filament profile first.","prusa":"Use Prusa profile and small adjustments."},"sources":["https://www.creality.com/blog/most-common-3d-printing-problems","https://blog.prusa3d.com/everything-about-nozzles-with-a-different-diameter_8344/"]},
    {"id":"warping","name":"Warping","symptoms":["Corners lift","Bottom curls","Part releases early"],"likely_causes":[{"cause":"Needs diagnosis from symptoms and printer condition","likelihood":"medium"}],"fixes":[{"slicer_key":"bed_temperature","direction":"increase","amount":"5-10 C","note":"Use material-appropriate range"},{"slicer_key":"brim_width","direction":"increase","amount":"3-10 mm","note":"Add bed contact"},{"slicer_key":"part_cooling_fan","direction":"decrease","amount":"10-50%","note":"For ABS/ASA"},{"slicer_key":"enclosure","direction":"enable","amount":null,"note":"Reduce drafts"}],"printer_notes":{"creality_k1":"Use enclosure for ABS/ASA.","bambu":"Use Bambu chamber guidance.","prusa":"Use Prusa material guidance."},"sources":["https://www.creality.com/blog/most-common-3d-printing-problems","https://blog.prusa3d.com/everything-about-nozzles-with-a-different-diameter_8344/"]},
