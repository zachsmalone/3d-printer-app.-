    {"id":"elephant_foot","name":"Elephant foot","symptoms":["First layers wider","Bottom edges bulge","Bottom holes undersized"],"likely_causes":[{"cause":"Needs diagnosis from symptoms and printer condition","likelihood":"medium"}],"fixes":[{"slicer_key":"z_offset","direction":"increase","amount":"0.02-0.05 mm","note":"Raise nozzle slightly"},{"slicer_key":"bed_temperature","direction":"decrease","amount":"5-10 C after first layers","note":"If supported"},{"slicer_key":"first_layer_line_width","direction":"decrease","amount":"5-10%","note":"If first layer too wide"},{"slicer_key":"elephant_foot_compensation","direction":"enable","amount":"0.1-0.2 mm","note":"Last resort"}],"printer_notes":{"creality_k1":"Adjust Z offset slightly.","bambu":"Use first-layer calibration.","prusa":"Use live Z and first-layer calibration."},"sources":["https://www.creality.com/blog/most-common-3d-printing-problems","https://blog.prusa3d.com/everything-about-nozzles-with-a-different-diameter_8344/"]},
