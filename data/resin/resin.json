  "title": "Resin printing troubleshooting and safety",
  "status": "batch_4_of_4",
  "usage": "Use for resin-specific Smart Fix guidance. Resin settings vary substantially by printer, resin, wavelength, exposure, temperature, and model orientation.",
  "problems": [
    {"id":"resin_print_fails_to_adhere","name":"Print fails to adhere to build plate","symptoms":["First layers remain on FEP","Print detaches during exposure","Empty plate after print"],"likely_causes":[{"cause":"Build-plate Z zero is wrong","likelihood":"high"},{"cause":"Bottom exposure time too low","likelihood":"high"},{"cause":"Build plate is dirty or resin-cured","likelihood":"medium"},{"cause":"Resin temperature too low","likelihood":"medium"}],"fixes":[{"setting_key":"resin_z_zero","direction":"recalibrate","amount":"needs calibration","note":"Re-zero the build plate."},{"setting_key":"bottom_exposure_time","direction":"increase","amount":"10-30%","note":"Increase gradually; excessive exposure makes removal difficult."},{"setting_key":"build_plate_clean","direction":"maintenance","amount":null,"note":"Clean cured resin from the plate."},{"setting_key":"resin_temperature","direction":"increase","amount":"20-30 C ambient target","note":"Use the resin manufacturer's recommended temperature range."}],"safety":["Wear nitrile gloves and eye protection.","Do not use paper towels that shed fibers near the vat.","Clean spills before curing."],"sources":["https://forgelabs.com/design-guides/sla","https://www.hubs.com/knowledge-base/how-design-parts-sla-3d-printing/"]},
    {"id":"resin_layer_separation","name":"Layer separation or delamination","symptoms":["Print splits at a layer","Partial print remains on FEP","Horizontal failure plane"],"likely_causes":[{"cause":"Normal exposure time too low","likelihood":"high"},{"cause":"Lift speed too high","likelihood":"high"},{"cause":"Resin temperature too low","likelihood":"medium"},{"cause":"Insufficient support density or attachment area","likelihood":"medium"}],"fixes":[{"setting_key":"normal_exposure_time","direction":"increase","amount":"5-15%","note":"Increase gradually and run an exposure test."},{"setting_key":"lift_speed","direction":"decrease","amount":"20-50%","note":"Reduce peel forces."},{"setting_key":"support_density","direction":"increase","amount":"10-30%","note":"Add supports for large cross-sections."},{"setting_key":"resin_temperature","direction":"increase","amount":"20-30 C ambient target","note":"Use manufacturer guidance."}],"safety":["Cure waste before disposal according to local rules.","Do not pour uncured resin down drains."],"sources":["https://forgelabs.com/design-guides/sla"]},
    {"id":"resin_details_lost","name":"Details lost or over-cured","symptoms":["Fine details filled in","Bloated features","Loss of small negative space"],"likely_causes":[{"cause":"Normal exposure time too high","likelihood":"high"},{"cause":"Bottom exposure too high","likelihood":"medium"},{"cause":"Resin is over-temperature","likelihood":"medium"},{"cause":"Anti-aliasing or grayscale settings unsuitable","likelihood":"medium"}],"fixes":[{"setting_key":"normal_exposure_time","direction":"decrease","amount":"5-15%","note":"Use an exposure test."},{"setting_key":"bottom_exposure_time","direction":"decrease","amount":"10-20%","note":"Only if bottom layers are over-cured."},{"setting_key":"anti_aliasing","direction":"adjust","amount":"needs calibration","note":"Use printer/resin-appropriate setting."},{"setting_key":"resin_temperature","direction":"decrease","amount":"needs calibration","note":"Keep within manufacturer range."}],"safety":["Uncured resin is irritating; avoid skin contact.","Wash hands and tools after handling."],"sources":["https://forgelabs.com/design-guides/sla"]},
    {"id":"resin_holes_sealed","name":"Small holes or channels sealed","symptoms":["Holes missing","Channels blocked","Fine negative features absent"],"likely_causes":[{"cause":"Feature below printer resolution","likelihood":"high"},{"cause":"Exposure time too high","likelihood":"high"},{"cause":"Resin trapped in enclosed cavity","likelihood":"high"},{"cause":"Model orientation traps resin","likelihood":"medium"}],"fixes":[{"setting_key":"hole_diameter","direction":"increase","amount":"0.2-0.5 mm","note":"Increase model feature size."},{"setting_key":"normal_exposure_time","direction":"decrease","amount":"5-15%","note":"Use exposure calibration."},{"setting_key":"drain_holes","direction":"add","amount":"at least 2 holes","note":"Add drainage for hollow parts."},{"setting_key":"model_orientation","direction":"change","amount":"rotate","note":"Prevent resin pooling."}],"safety":["Never cure a sealed container of uncured resin; trapped resin can build pressure.","Drain hollow prints before curing."],"sources":["https://www.hubs.com/knowledge-base/how-design-parts-sla-3d-printing/","https://jlc3dp.com/help/article/3d-printing-design-guideline"]},
    {"id":"resin_pillowing","name":"Pillowing or suction cupping","symptoms":["Large flat roof deforms","Suction marks","Hollow print collapses inward"],"likely_causes":[{"cause":"Insufficient vent/drain holes","likelihood":"high"},{"cause":"Large flat layer creates suction","likelihood":"high"},{"cause":"Lift speed too high","likelihood":"medium"},{"cause":"Insufficient supports on downward-facing surfaces","likelihood":"medium"}],"fixes":[{"setting_key":"drain_holes","direction":"add","amount":"at least 2 holes","note":"Add vent and drain holes."},{"setting_key":"lift_speed","direction":"decrease","amount":"20-50%","note":"Reduce suction forces."},{"setting_key":"supports","direction":"increase","amount":"10-30%","note":"Support large flat roofs."},{"setting_key":"model_orientation","direction":"change","amount":"rotate","note":"Avoid broad parallel layers."}],"safety":["Drain uncured resin completely before washing and curing."],"sources":["https://www.hubs.com/knowledge-base/how-design-parts-sla-3d-printing/"]},
    {"id":"resin_brittle_parts","name":"Brittle or weak resin parts","symptoms":["Parts snap easily","Cracks after curing","Poor impact strength"],"likely_causes":[{"cause":"Under-curing after wash","likelihood":"high"},{"cause":"Over-curing in UV station","likelihood":"medium"},{"cause":"Thin walls or sharp corners","likelihood":"medium"},{"cause":"Wrong resin for load","likelihood":"medium"}],"fixes":[{"setting_key":"post_cure_time","direction":"adjust","amount":"needs calibration","note":"Follow resin-specific cure schedule."},{"setting_key":"wall_thickness","direction":"increase","amount":"0.5-1.0 mm","note":"Use thicker walls for structural parts."},{"setting_key":"fillet_radius","direction":"increase","amount":"0.5-1.0 mm","note":"Reduce stress concentrations."},{"setting_key":"resin_selection","direction":"change","amount":"tough resin","note":"Use a tough or engineering resin for impact loads."}],"safety":["Fully cure waste and failed prints before disposal.","Follow local hazardous-waste rules."],"sources":["https://xometry.pro/en-eu/articles/3d-printing-sla-design-tips/","https://forgelabs.com/design-guides/sla"]},
    {"id":"resin_thin_pins_fail","name":"Thin pins or features fail","symptoms":["Pins break","Fine posts missing","Small features deform"],"likely_causes":[{"cause":"Pin diameter too small","likelihood":"high"},{"cause":"Insufficient exposure","likelihood":"medium"},{"cause":"Model orientation creates weak layer orientation","likelihood":"medium"},{"cause":"Resin too brittle","likelihood":"medium"}],"fixes":[{"setting_key":"pin_diameter","direction":"increase","amount":"at least 1 mm minimum; 2 mm preferred","note":"Use thicker pins for handling and durability."},{"setting_key":"normal_exposure_time","direction":"increase","amount":"5-10%","note":"Only if exposure test shows under-cure."},{"setting_key":"model_orientation","direction":"change","amount":"rotate","note":"Reduce stress on thin features."},{"setting_key":"resin_selection","direction":"change","amount":"tough resin","note":"Use tougher resin for functional pins."}],"safety":["Handle uncured resin parts with gloves.","Do not cure resin on skin."],"sources":["https://xometry.pro/en-eu/articles/3d-printing-sla-design-tips/"]}
  ],
  "safety": {
    "personal_protection": ["Wear nitrile gloves and safety glasses.", "Avoid skin contact with uncured resin.", "Do not inhale resin fumes; use ventilation."],
