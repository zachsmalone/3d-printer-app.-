# STAGING environment — mirrors production config, NEVER holds production data.
# Seed with dummy accounts only; restore drills happen here (docs/ops/backup-restore.md).

ZEIM_DOMAIN=staging.zeim.example.org
ACME_EMAIL=ops@example.org
PHOTO3D_ADMIN_TOKEN=            # openssl rand -hex 32 (STAGING value, not the prod one)
PHOTO3D_SECRET_KEY=             # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZEIM_HOST_DIR=/srv/zeim-staging

PHOTO3D_MODE=shared
PHOTO3D_PUBLIC_BASE_URL=https://staging.zeim.example.org

# Staging runs the production posture: db storage, auth fail-closed, printer SSRF guard
ZEIM_STORAGE=db
ZEIM_ENV=production
ZEIM_RP_ID=staging.zeim.example.org
ZEIM_ORIGINS=https://staging.zeim.example.org
ZEIM_AUTH_PEPPER=               # openssl rand -hex 32
ZEIM_TRUST_PROXY=1
PHOTO3D_COOKIE_SECURE=auto
PHOTO3D_BLOCK_PRIVATE_PRINTERS=1
PHOTO3D_API_DOCS=1              # staging only: docs on, so the staging API surface is inspectable

# Object storage (optional; unset = local disk, which is fine for staging)
# PHOTO3D_S3_ENDPOINT=
# PHOTO3D_S3_BUCKET=
# PHOTO3D_S3_KEY=
# PHOTO3D_S3_SECRET=

# Paid plans stay closed on staging too. No Stripe keys.
ZEIM_PLANS_ENABLED=0
# 0 = full app. 1 = coming-soon page except /healthz.
ZEIM_COMING_SOON=0
# Photo-to-3D stays off on staging unless you are explicitly testing that worker.
ZEIM_2D3D_ENABLED=0
# Testing mode stays off unless you are deliberately lifting usage quotas. It does not open payments.
ZEIM_TESTING_MODE=0
ZEIM_TESTING_ALLOW_PAID=0

# SMTP (optional on staging; without it email codes are off and passkeys are the only login)
# ZEIM_SMTP_HOST=
# ZEIM_SMTP_PORT=587
# ZEIM_SMTP_FROM=
